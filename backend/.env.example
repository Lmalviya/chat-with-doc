# Environment Configuration Template
# Copy this file to .env and fill in your secrets

APP_NAME="QnA Bot with Docs"
APP_ENV=development
APP_DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/qnadb
DATABASE_PROJECT_REF=your_supabase_project_ref
DATABASE_PASSWORD=your_database_password
DATABASE_REGION=us-east-1
DATABASE_HOST=pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres

# Supabase Auth Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# LLM & Embeddings API Keys
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=qna-bot-with-docs
LANGCHAIN_HUB_OWNER=your_langchain_hub_owner

# Vector DB / Embeddings (Qdrant / Milvus / etc.)
EMBEDDING_MODEL=gemini-embedding-001
